<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>Latest</LangVersion>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Authors>The Tech Idea</Authors>
		<Company>The Tech Idea</Company>
		<Copyright>2024</Copyright>
		<PackageProjectUrl>https://github.com/The-Tech-Idea/</PackageProjectUrl>
		<PackageIcon>SimpleODM.png</PackageIcon>
		<RepositoryUrl>https://github.com/The-Tech-Idea/BeepDataSources</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Title>TheTechIdea.Beep.SqlServerDataSourceCore</Title>
		<PackageId>TheTechIdea.Beep.SqlServerDataSourceCore</PackageId>
		<Version>1.0.1</Version>

	</PropertyGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Copy SourceFiles="$(TargetDir)$(MSBuildProjectName).dll" DestinationFolder="$(ProjectDir)..\..\..\outputDLL\DataSources\$(MSBuildProjectName)\$(TargetFramework)" SkipUnchangedFiles="false" />
	</Target>
	<Target Name="CopyPackage" AfterTargets="Pack">
		<Copy SourceFiles="$(OutputPath)$(PackageId).$(PackageVersion).nupkg" DestinationFolder="..\..\..\..\LocalNugetFiles\DataSources" />
	</Target>
	<ItemGroup>
		<None Include="..\..\..\InstallationScripts\LogoGFx\128\SimpleODM.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	    <!-- Project references, not packages: the local BeepDM sources carry fixes not yet
         published (primary keys were emitted as nullable, blocking every migration). Mixing a
         package copy with the project copy would load the same types twice. -->
    <ProjectReference Include="..\..\..\BeepDM\DataManagementEngineStandard\DataManagementEngine.csproj" />
    <ProjectReference Include="..\..\..\BeepDM\DataManagementModelsStandard\DataManagementModels.csproj" />
</ItemGroup>
<ItemGroup>
		<Compile Include="..\..\DataSourcesPlugins\SQLServerDataSource\*.cs" />
		<EmbeddedResource Include="..\..\DataSourcesPlugins\SQLServerDataSource\**\*.resx" />
</ItemGroup>
<ItemGroup>
  <Compile Remove="..\..\DataSourcesPlugins\SQLServerDataSource\SQLServerDataSource.cs" />
</ItemGroup>
<ItemGroup>
  <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
  <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
  <!-- Project reference, not the 2.0.22 package: RDBSource is actively fixed in this repo. The
       Debug-only "Get Tables List Query" trace used to be logged as Errors.Failed, so every caller
       that inspects ErrorObject after a successful table list saw a failure that never happened. -->
  <ProjectReference Include="..\..\DataSourcesPlugins\RDBMSDataSource\RDBDataSource.csproj" />
</ItemGroup>
<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
  <PackageReference Include="CouchDB.NET">
    <Version>4.1.0</Version>
  </PackageReference>
</ItemGroup>


</Project>